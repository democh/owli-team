{
  "id": "debate",
  "name": "辩论场：正反交锋 × 证据归拢 × 裁判裁决",
  "participants": ["judge", "affirmative", "negative", "evidence"],
  "prompt": "辩题：AI 生成内容是否应强制标注来源（默认 3 轮）。@明断 开场定规矩并终局裁决；@立言 持正方立论（三条论点各挂证据与置信度）、@砺锋 持反方立论并攻击假设与证据；@昭实 归拢双方共用证据清单与缺口（附核验状态）；轮间互应后由裁判给出胜负 + 置信度 + 核心依据 + 翻盘条件。",
  "maxTurns": 8,
  "assertions": [
    { "type": "artifact_exists", "path": "docs/正方立论-内容.md" },
    { "type": "artifact_exists", "path": "docs/反方立论-内容.md" },
    { "type": "artifact_exists", "path": "docs/证据清单-内容.md" },
    { "type": "artifact_exists", "path": "docs/辩论裁决-内容.md" },
    { "type": "artifact_contains", "path": "docs/辩论裁决-内容.md", "text": "翻盘条件" },
    { "type": "artifact_contains", "path": "docs/辩论裁决-内容.md", "text": "模拟声明" },
    { "type": "artifact_contains", "path": "docs/正方立论-内容.md", "text": "证据引用表" },
    { "type": "artifact_contains", "path": "docs/证据清单-内容.md", "text": "核验状态" },
    { "type": "handoff_targets", "values": ["affirmative", "negative", "evidence"] },
    { "type": "turns_lte", "value": 5 },
    { "type": "no_loop" },
    { "type": "token_budget_ok" },
    { "type": "run_end_reason", "value": "completed" },
    {
      "type": "judge",
      "rubric": "辩论须完整：正方立论给出论点链并逐条挂证据与置信度；反方先复述正方最强版本再攻击假设/推理/证据，不逐条缠斗；证据官归拢双方共用证据（含来源等级与核验状态）并列出缺口；裁判给出胜负 + 置信度 + 核心依据 + 翻盘条件，并声明裁决为基于给定证据的推演。全程对事不对人、不偷换概念、无证据主张不计胜势。",
      "minScore": 7
    }
  ]
}
