{
  "id": "trpg",
  "name": "跑团工坊：剧本 × 主持 × NPC × 规则",
  "participants": ["scenario-writer", "gm-host", "npc-player", "rule-keeper"],
  "prompt": "组织一场单发跑团：@构幕 出剧本框架（背景/冲突/三条线索），@开卷 主持开场回合，@入戏 给两位关键 NPC 设定，@执规 定规则口径与安全工具；全程玩家向娱乐体验。",
  "maxTurns": 7,
  "assertions": [
    { "type": "artifact_exists", "path": "docs/剧本-这个需求.md" },
    { "type": "artifact_exists", "path": "docs/战报-这个需求.md" },
    { "type": "artifact_exists", "path": "docs/NPC设定-这个需求.md" },
    { "type": "artifact_exists", "path": "docs/规则裁决-这个需求.md" },
    { "type": "turns_lte", "value": 6 },
    { "type": "no_loop" },
    { "type": "run_end_reason", "value": "completed" }
  ]
}
