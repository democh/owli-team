{
  "id": "tarot",
  "name": "塔罗研习：三张牌阵解读 × 意象 × 考据",
  "participants": ["tarot-reader", "symbol-narrator", "tarot-historian"],
  "prompt": "做一次三张牌阵研习：@观照 抽牌并按牌阵解读（牌面为据不作宿命断言），@释象 就关键牌面做意象叙事，@考源 给核心牌义的历史出处；收尾汇总解读札记并注明文化参考定位。",
  "maxTurns": 6,
  "assertions": [
    { "type": "artifact_exists", "path": "docs/塔罗解读-这个需求.md" },
    { "type": "artifact_exists", "path": "docs/意象札记-这个需求.md" },
    { "type": "artifact_exists", "path": "docs/塔罗考据-这个需求.md" },
    { "type": "handoff_targets", "values": ["symbol-narrator"] },
    { "type": "turns_lte", "value": 5 },
    { "type": "no_loop" },
    { "type": "run_end_reason", "value": "completed" },
    { "type": "message_no_banned_words", "values": ["综上所述", "总而言之", "赋能", "抓手", "颗粒度", "希望对你有帮助", "如有问题随时提问"] }
  ]
}
