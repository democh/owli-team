# 全部变量都可省略；缺省值见 server/src/config.ts。
# 覆盖优先级：data/settings.json（UI 可改） > 环境变量 > 内置默认值。

# ---- 服务端 ----
PORT=8787
# 暴露到局域网时置 true（此时必须配置 AUTH_TOKEN，否则拒绝启动）
BIND_ALL=false
AUTH_TOKEN=
# 允许的跨域来源（逗号分隔；留空 = 不限制，仅本地开发建议留空）
ALLOWED_ORIGINS=
# 日志级别：trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ---- LLM ----
# 必填：未配置 Key 时服务拒绝启动（无自动降级；离线演示可显式 LLM_MOCK=true）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# E2E / 离线演示：显式启用脚本化 Mock（零网络，无需 Key；生产勿开）
LLM_MOCK=false
# Mock 分片延时（ms）：E2E 可调大让流式/插话/停止可观察
LLM_MOCK_DELAY_MS=8
# 摘要压缩与评测裁判模型（留空 = 复用 LLM_MODEL）
SUMMARY_MODEL=
JUDGE_MODEL=
# 采样温度（角色 front-matter 可覆盖）
LLM_TEMPERATURE=0.6
# 并发上限与重试
LLM_MAX_CONCURRENCY=3
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=500
# 超时分层（毫秒）：首 token / 流空闲 / 单回合上限
FIRST_TOKEN_TIMEOUT_MS=30000
STREAM_IDLE_TIMEOUT_MS=60000
TURN_TIMEOUT_MS=120000
# 单价表（每 1K token，美元；JSON），用于成本估算
LLM_PRICING_JSON=

# ---- 思考模式（DeepSeek V4）----
# off（默认）：不产出思维链，响应更快、更省；on：流式产出思考内容并展示在前端
LLM_THINKING=off
# 思考强度（仅 LLM_THINKING=on 生效）：low | high | max
LLM_REASONING_EFFORT=high

# ---- 编排 ----
MAX_TURNS_PER_RUN=10
# 单波并行成员上限（1 = 关闭并行；场景可在 _group.yaml 用 parallelMax 覆盖）
PARALLEL_MAX=3
# 转交机制：auto（优先 handoff 工具，回退文本 @）| tool | text
HANDOFF_MODE=auto

# 结构化输出请求形态（M2 摘要 / M9 judge）：json_object（兼容最好）| json_schema | off
LLM_JSON_MODE=json_object
# ---- 上下文工程 ----
# 上下文预算（token）；压缩触发线 = 预算 × 0.7
CONTEXT_BUDGET_TOKENS=60000
# 最近 K 个回合保留原文（不参与压缩）
KEEP_RECENT_TURNS=6
# 单条工具结果上限（超出截断并提示用 offset 续读）
TOOL_RESULT_MAX_TOKENS=4000
# 最近 N 条工具结果保留 detail，更早折叠为一行摘要
TOOL_DETAIL_KEEP=6

# ---- 目录 ----
# Agent 资产包目录（<场景>/<角色>/ 单包结构：AGENT.md + 可选 souls/ + avatar.png）
AGENTS_DIR=agents
# 兼容回退（旧版）：agents/ 不存在时按旧逻辑加载 prompts/，并启动告警
PROMPTS_DIR=prompts
SKILLS_DIR=skills
DATA_DIR=data
WORKSPACE_DIR=workspace
# git worktree 目录（repo/worktree 模式）
WORKTREE_DIR=data/worktrees
LOG_DIR=data/logs
DB_FILE=data/app.db
SETTINGS_FILE=data/settings.json

# ---- 工具 ----
MAX_TOOL_STEPS=8
TOOL_TIMEOUT_MS=20000
ALLOW_RUN_COMMAND=false
# run_command 白名单（逗号分隔；留空 = 使用内置安全清单）
ALLOWED_COMMANDS=
# 允许挂载为项目根的目录白名单（逗号分隔；留空 = 仅限 workspace 内）
ALLOWED_ROOTS=
# 放开敏感文件（.env* / .ssh / *.pem / id_rsa*）读写；即便放开仍需审批
ALLOW_SENSITIVE=false
# web_fetch 白名单域名（逗号分隔；留空 = 工具不可用）
WEB_FETCH_ALLOWED_DOMAINS=
ARTIFACT_MAX_BYTES=524288

# ---- 联网检索（web_search：百度检索）----
# 开启 web_search；未配 API Key 时抓取百度结果页（免 Key，但可能触发风控）
WEB_SEARCH_ENABLED=false
# 千帆「百度搜索」API Key（推荐：官方 API、结构化结果、每月免费额度，无风控）
BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_API_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
# 联网工具浏览器 UA 覆盖（留空 = 内置 Chrome 桌面版 UA）
HTTP_USER_AGENT=
# 同域名最小请求间隔（毫秒，反爬限速；0 = 不限速）
HTTP_MIN_INTERVAL_MS=1200
# 单次联网请求超时（毫秒）
HTTP_TIMEOUT_MS=15000

# ---- 向量记忆（M25）----
# 嵌入凭据推荐在「连接中心」新建 embedding 连接后在「设置 → 向量记忆」选择；
# 以下 env 仅作后备（无连接中心配置时生效）。EMBEDDING_CONNECTION_ID 与 EMBEDDING_* 互斥优先。
EMBEDDING_CONNECTION_ID=
# OpenAI 兼容 /embeddings 端点（留空 = 官方 OpenAI；Ollama 等本地端点可留空 Key）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 向量维度（0 = 首次调用自动探测）
EMBEDDING_DIM=0
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=15000
# 语义召回（L1.5）：开关 / topK / 最低分门槛 / 注入预算（tokens）/ 超时（毫秒，超时静默跳过）
MEMORY_RECALL_ENABLED=true
MEMORY_RECALL_TOPK=8
MEMORY_RECALL_MIN_SCORE=0.25
MEMORY_RECALL_BUDGET_TOKENS=600
MEMORY_RECALL_TIMEOUT_MS=300
# Run 后自动沉淀（候选待审）：off（默认）| session（仅主 Run）| all（含轻量 Run）
MEMORY_DIGEST_MODE=off

# ---- 审批与安全（HITL）----
# off | risky（默认，仅高风险工具） | all
APPROVAL_MODE=risky
APPROVAL_TIMEOUT_MS=600000
# 额外强制审批的工具名（逗号分隔）
APPROVAL_TOOLS=
# 计划审批挂起等待时长（0 = 无限等待，驳回/批准均回灌作者）
PLAN_REVIEW_TIMEOUT_MS=0
# 消息接口限流（每 IP 每分钟上限）
MESSAGE_RATE_LIMIT=30

# ---- MCP（可选；仅作启动种子导入，此后以「MCP 管理」台为唯一真相）----
# 格式：name=command args...（stdio）或 name=https://host/mcp（Streamable HTTP），逗号分隔
# 注意：每次启动按 name 补建缺失项——同名（含已被管理台删除的）会重新导入，不想要即从此行移除
MCP_SERVERS=

# ---- MCP JSON 直配（M28；生态标准 mcpServers 格式，文件权威）----
# 配置文件（相对仓库根；Claude Desktop / Claude Code 配置可直接拷贝；source='json' 的服务器在管理台只读）
# 同步时机：启动（先于 MCP_SERVERS 种子）→ mtime 轮询 → 管理台「立即同步」；解析失败绝不清空服务器
MCP_CONFIG_FILE=mcp.json
# mtime 轮询间隔（毫秒；0 = 关闭轮询，仅启动同步 + 手动同步）
MCP_CONFIG_POLL_MS=5000

# ---- 工具按需发现（M28，渐进披露；核心工具常驻，重型与 MCP 工具经 tool_search 激活）----
# auto（默认，可延迟工具达阈值才启用）| on（强制启用）| off（回退全量加载，同旧版）
TOOL_SEARCH_MODE=auto
# auto 阈值：单个 Agent 可延迟工具数 ≥ TOOL_SEARCH_MIN 或 schema 估算 token ≥ 上下文预算的 TOOL_SEARCH_TOKEN_PCT%
TOOL_SEARCH_MIN=10
TOOL_SEARCH_TOKEN_PCT=10
# 单次 tool_search 最多激活工具数（1-10）
TOOL_SEARCH_LIMIT=5

# ---- WebSocket 通知 ----
WS_HEARTBEAT_MS=30000
WS_REPLAY_BUFFER=200
RUN_DETACH_ON_DISCONNECT=true
ASYNC_RUN_MAX=3
NOTIFY_POLL_MS=5000

# ---- 浏览器（M22；CDP 接入与可视化）----
# 默认接入模式：managed（独立实例，临时配置）| local（本机 Chrome，专用持久 Profile）| remote（接入已有调试端点）
BROWSER_BACKEND=local
# 浏览器可执行文件路径（留空 = 自动发现）
BROWSER_EXECUTABLE=
# 启动形态：true=无头（默认，不弹窗口）| false=打开可见窗口（适合登录 / 人工观察）
# 决策链：面板 / 接口显式参数 → 连接 config.headless → 本全局默认
BROWSER_HEADLESS=true
# CDP 保活周期（ms）：静默期发协议 ping，两个周期无入站判定半开并触发自动重连（5000-300000）
BROWSER_KEEPALIVE_MS=15000
# 是否允许自动发现本机浏览器与调试端点
BROWSER_AUTO_DISCOVER=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
# 帧流每客户端上限帧率 / JPEG 品质（0-100）
BROWSER_FRAME_MAX_FPS=12
BROWSER_FRAME_QUALITY=70
# 步骤截图（时间轴证据）开关与落盘目录
BROWSER_STEP_SHOTS=true
BROWSER_SCREENSHOT_DIR=data/screenshots
# 帧流 watch / takeover token 有效期（毫秒）
BROWSER_STREAM_TOKEN_TTL_MS=300000

# ---- 金融投研（M34）----
# 总开关（false = 入口隐藏、fin_* 不出现在工具面；离线/演示环境零影响）
FINANCE_ENABLED=false
# Python 解释器路径（缺省自动探测 python3/python/py -3；baostock/akshare 桥用）
FINANCE_PYTHON=
# Python 桥单任务超时（毫秒）
FINANCE_PY_TIMEOUT_MS=30000
# pip 镜像（缺省官方源；一键安装用）
FINANCE_PIP_INDEX_URL=
# 金融源同域最小请求间隔（毫秒；0 = 复用 HTTP_MIN_INTERVAL_MS）
FINANCE_MIN_INTERVAL_MS=1200
# 行情 Tab 轮询间隔（交易时段内；毫秒）
FINANCE_QUOTE_REFRESH_MS=10000
# 快照落盘目录（会话工作区内相对路径）
FINANCE_KLINE_SNAPSHOT_DIR=charts
# 博弈 ABM 路径数上限（计算护栏）
FINANCE_GAME_MAX_PATHS=2000
# 博弈模拟默认随机种子（相同种子可复现）
FINANCE_GAME_SEED=20260918

# ---- 定时任务（M35）----
# 总开关（默认开启：纯本地零网络；false = tick 不启动、工具与接口返回未装配）
SCHEDULE_ENABLED=true
# 调度 tick 轮询间隔（毫秒；5000-600000）
SCHEDULE_TICK_MS=30000
# 默认时区（IANA 名，如 Asia/Shanghai；空 = 服务器时区；非法值回退并告警一次）
SCHEDULE_TZ=
# 单会话任务数上限（防额度滥用）
SCHEDULE_MAX_PER_SESSION=20
# 最小触发间隔（毫秒；高频护栏，硬下限 60000）
SCHEDULE_MIN_GAP_MS=300000
# 停机补跑窗口（毫秒；超窗的错过触发按 skipped-missed 跳过而非引爆）
SCHEDULE_CATCHUP_MS=600000
# 连续失败自动暂停阈值（1-10）
SCHEDULE_FAIL_LIMIT=3
